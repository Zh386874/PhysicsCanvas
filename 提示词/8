## 第二层：场景生成器（JSON → 场景配置）

解析返回的 JSON 后，需要将其转换为项目内部的状态格式。可以编写一个 `useSceneBuilder` composable：

```typescript
// src/composables/useSceneBuilder.ts
export function useSceneBuilder() {
  const { loadPreset, presets } = usePresets();
  const { state } = usePhysics();

  function buildScene(aiResult: ParsedProblem) {
    // 1. 如果 topic 匹配预设，直接加载预设并覆盖参数
    const presetMap = {
      projectile: 'preset1',
      slope: 'preset2',
      elastic_collision: 'preset3',
      magnetic_circle: 'preset4',
      electric_deflection: 'preset5'
    };
    
    if (aiResult.topic in presetMap) {
      loadPreset(presetMap[aiResult.topic]);
    }

    // 2. 覆盖/新建物体
    state.objects = aiResult.objects.map(obj => ({
      id: nanoid(),
      type: obj.type === 'ball' ? 'circle' : 'platform',
      x: obj.initialPosition.x * PIXELS_PER_METER,
      y: obj.initialPosition.y * PIXELS_PER_METER,
      vx: obj.initialVelocity.x * PIXELS_PER_METER,
      vy: obj.initialVelocity.y * PIXELS_PER_METER,
      mass: obj.mass,
      charge: obj.charge,
      radius: obj.radius * PIXELS_PER_METER,
      // ...其他默认属性
    }));

    // 3. 设置场
    if (aiResult.field.type === 'electric') {
      state.field = { type: 'electric', E: aiResult.field.E, B: 0 };
    } else if (aiResult.field.type === 'magnetic') {
      state.field = { type: 'magnetic', E: { x: 0, y: 0 }, B: aiResult.field.B };
    }

    // 4. 全局参数
    state.gravity = aiResult.gravity * PIXELS_PER_METER;
    state.groundY = aiResult.groundY * PIXELS_PER_METER;
  }

  return { buildScene };
}
```

**关键转换**：AI 返回的物理量是 SI 单位，必须乘以 `PIXELS_PER_METER` 才能用于模拟。

