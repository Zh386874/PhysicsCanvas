### 3. 组合式函数 `useQuestionBank`

负责加载、筛选、应用到场景。

```typescript
// src/composables/useQuestionBank.ts
import { ref, computed } from 'vue'
import type { QuestionItem } from '@/types/questionBank'
import { slopeQuestions } from '@/data/questionBank/slope'
import { collisionQuestions } from '@/data/questionBank/collision'
import { springQuestions } from '@/data/questionBank/spring'
// 后续可直接添加更多文件

const allQuestions = [
  ...slopeQuestions,
  ...collisionQuestions,
  ...springQuestions
]

// 当前选中的题目 ID
const selectedId = ref<string | null>(null)

// 全部题目列表
const questions = ref<QuestionItem[]>(allQuestions)

// 筛选条件
const filterDifficulty = ref<'all' | 'easy' | 'medium' | 'hard'>('all')
const filterTag = ref<string | null>(null)

const filteredQuestions = computed(() => {
  return questions.value.filter(q => {
    if (filterDifficulty.value !== 'all' && q.difficulty !== filterDifficulty.value) return false
    if (filterTag.value && !q.tags.includes(filterTag.value)) return false
    return true
  })
})

// 获取当前选中的题目
const selectedQuestion = computed(() => {
  return questions.value.find(q => q.id === selectedId.value) || null
})

// 将选中题目应用到物理场景（调用你已有的场景加载逻辑）
async function applyQuestionToScene(sceneLoader: (scene: QuestionItem['sceneJson']) => void) {
  if (!selectedQuestion.value) return
  sceneLoader(selectedQuestion.value.sceneJson)
}

export function useQuestionBank() {
  return {
    questions,
    filteredQuestions,
    selectedId,
    selectedQuestion,
    filterDifficulty,
    filterTag,
    applyQuestionToScene
  }
}
```

### 4. 侧边栏 UI 组件 (Vue 3)

```vue
<!-- src/components/QuestionBankPanel.vue -->
<template>
  <div class="question-bank-panel">
    <h3>📚 真题库</h3>
    
    <!-- 筛选栏 -->
    <div class="filters">
      <select v-model="filterDifficulty">
        <option value="all">全部难度</option>
        <option value="easy">简单</option>
        <option value="medium">中等</option>
        <option value="hard">困难</option>
      </select>
      <select v-model="filterTag">
        <option :value="null">全部标签</option>
        <option v-for="tag in allTags" :key="tag" :value="tag">{{ tag }}</option>
      </select>
    </div>

    <!-- 题目列表 -->
    <div class="question-list">
      <div
        v-for="q in filteredQuestions"
        :key="q.id"
        class="question-item"
        :class="{ active: selectedId === q.id }"
        @click="selectQuestion(q.id)"
      >
        <div class="question-title">{{ q.title }}</div>
        <div class="question-desc">{{ q.description.substring(0, 50) }}...</div>
        <div class="question-tags">
          <span
            v-for="tag in q.tags"
            :key="tag"
            class="tag"
            :class="'difficulty-' + q.difficulty"
          >
            {{ tag }}
          </span>
        </div>
      </div>
    </div>

    <!-- 加载按钮 -->
    <button
      class="apply-btn"
      :disabled="!selectedId"
      @click="handleApply"
    >
      加载场景并播放
    </button>
  </div>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { useQuestionBank } from '@/composables/useQuestionBank'
import { useSceneStore } from '@/stores/scene' // 假设你有一个场景 store

const {
  filteredQuestions,
  selectedId,
  filterDifficulty,
  filterTag,
  applyQuestionToScene
} = useQuestionBank()

const sceneStore = useSceneStore()

// 从题目中提取所有不重复标签
const allTags = computed(() => {
  const tags = new Set<string>()
  filteredQuestions.value.forEach(q => q.tags.forEach(t => tags.add(t)))
  return Array.from(tags)
})

function selectQuestion(id: string) {
  selectedId.value = id
}

async function handleApply() {
  // 传入场景加载函数，该函数应能重置场景并填入新的 objects/constraints
  await applyQuestionToScene((sceneJson) => {
    sceneStore.loadScene(sceneJson)    // 你的场景加载逻辑
    sceneStore.play()                  // 自动开始模拟
  })
}
</script>
```

### 5. 集成到主界面

在布局中，将 `QuestionBankPanel` 放在画布左侧或作为一个可折叠的侧边栏即可。配合你已有的 AI 输入组件，用户既可以通过“AI 生成”获得场景，也可以从“真题库”一键加载。

