{
  "name": "physics-sim",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "vitest run tests/contracts",
    "test:coverage": "vitest run --coverage",
    "test:integrity": "node scripts/check-test-integrity.mjs HEAD~1 HEAD",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "coverage:check": "node scripts/check-coverage-regression.mjs",
    "coverage:save-baseline": "node scripts/save-coverage-baseline.mjs",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"*.{md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"*.{md,json}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "electron:dev": "vite build --config vite.electron.config.js && electron electron/main.js",
    "electron:build": "vite build --config vite.electron.config.js && electron-builder --win",
    "prepare": "husky"
  },
  "dependencies": {
    "element-plus": "^2.14.3",
    "vue": "^3.5.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.example.physics-sim",
    "productName": "物理解模",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
